{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,
    "noEmit": false,
    "outDir": "package-dist",
    "rootDir": "src"
  },
  "include": [
    "src/index.ts",
    "src/components/**/*.ts",
    "src/components/**/*.tsx",
    "src/assets/icons/Icon.tsx",
    "src/utils/**/*.ts"
  ],
  "exclude": ["src/**/*.stories.tsx"]
}
