    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
