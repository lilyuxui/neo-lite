{
  "name": "neo-lite",
  "version": "0.1.0",
  "description": "Accessible React components with a lightweight neo-brutalist visual language.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "files": [
    "package-dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run build:site",
    "build:site": "vite build",
    "build:package": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:vercel": "npm run build:site && HOME=.storybook-home STORYBOOK_DISABLE_TELEMETRY=1 storybook build --output-dir dist/storybook",
    "typecheck": "tsc --noEmit",
    "storybook": "HOME=.storybook-home STORYBOOK_DISABLE_TELEMETRY=1 storybook dev -p 6006",
    "build-storybook": "HOME=.storybook-home STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "prepack": "npm run typecheck && npm run build:package"
  },
  "main": "./package-dist/index.js",
  "module": "./package-dist/index.js",
  "types": "./package-dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./package-dist/index.d.ts",
      "import": "./package-dist/index.js"
    },
    "./styles.css": "./package-dist/neo-lite.css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lilyuxui/neo-lite.git"
  },
  "homepage": "https://github.com/lilyuxui/neo-lite#readme",
  "bugs": {
    "url": "https://github.com/lilyuxui/neo-lite/issues"
  },
  "keywords": [
    "react",
    "components",
    "design-system",
    "neo-brutalism",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shiki": "^4.4.3",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.3"
  }
}
